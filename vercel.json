{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact-safe.js" },
    { "src": "/api/contact-safe", "dest": "/api/contact-safe.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "functions": {
    "api/**.js": { "runtime": "nodejs18.x", "memory": 128, "maxDuration": 10 }
  }
}
